{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1) Dashboard Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app.py"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "2) Probar detector (imagen en blanco)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/detector.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "3) Probar gamificación",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gamification.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "4) Preparar dataset (split 70/15/15)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/prepare_dataset.py",
            "args": ["--source", "dataset/raw"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "5) Entrenar (CPU, prueba rápida 5 épocas)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": ["--data", "data.yaml", "--epochs", "5", "--batch", "8", "--device", "cpu"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "6) Evaluar en test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/evaluate.py",
            "args": ["--data", "data.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "7) Controlador Raspberry (mock en PC)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/raspi_controller.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
